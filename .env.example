# Copy this file to .env and fill in your values.
#
# The three keys below can also be set from Settings -> API Keys in the running app, with
# no restart. A key saved there takes precedence over the value here; clearing it falls
# back to this file.

# Required for PaliGemma-2 (accept license at https://huggingface.co/google/paligemma-2-3b-pt-224 first)
HF_TOKEN=

# Optional: Gelbooru API credentials for higher rate limits
GELBOORU_API_KEY=
GELBOORU_USER_ID=

# Optional: override default paths
# DATA_DIR=s:/Vibe_apps/Dataset_manager/data
# MODELS_CACHE_DIR=s:/Vibe_apps/Dataset_manager/models_cache
# DATABASE_URL=sqlite+aiosqlite:///./dataset_manager.db
